---
/**
 * AEOPage.astro
 *
 * Renders a generated page from its PageRecord. The record is the only input;
 * this component owns all markup and emits the JSON-LD itself, so structured
 * data cannot be forgotten at deploy time and cannot disagree with what the
 * page renders.
 *
 * Section order is fixed. Sections marked FIXED below are chrome the layout
 * owns and that is identical on every page; the similarity gate strips them
 * before scoring. Everything else is per-page prose and is what the gate reads.
 *
 * House rules: no em dashes, no JavaScript-gated content. Every word on this
 * page is present in the initial HTML response.
 */

import {
  assertValidPageRecord,
  FIXED_CHROME_SELECTORS,
  type PageRecord,
} from "../lib/page-contract";
import { buildPageSchema, faqPairsFor } from "../lib/page-schema";
import {
  renderSectionContent,
  injectInternalLinks,
  sanitizeForCrawlers,
} from "../utils/aeo-renderer";

interface Props {
  record: PageRecord;
  siteUrl?: string;
  organizationName?: string;
  organizationLogo?: string;
  /** Absolute URL of this page. Defaults to siteUrl + slug. */
  pageUrl?: string;
}

const {
  record: rawRecord,
  siteUrl = "https://generativeenginesolutions.com",
  organizationName = "Generative Engine Solutions",
  organizationLogo = "/images/logo-dark.png",
  pageUrl,
} = Astro.props;

// The last gate. A record that violates the contract fails the build rather
// than publishing a page that quietly breaks its own promises.
const record = assertValidPageRecord(rawRecord);

const {
  canonicalQuestion,
  title,
  answer,
  sections,
  tradeoffs,
  proof_points = [],
  entity_references = [],
  internal_links = [],
  sources = [],
  cta,
} = record;

const resolvedUrl =
  pageUrl ?? `${siteUrl.replace(/\/+$/, "")}/${record.slug.replace(/^\/+|\/+$/g, "")}/`;

const jsonld = buildPageSchema(record, {
  siteUrl,
  organizationName,
  organizationLogo,
  pageUrl: resolvedUrl,
});
const jsonldString = JSON.stringify(jsonld);

// The FAQ block renders exactly the pairs the FAQPage node carries, leading
// with the canonical question and its gated answer.
const faqs = faqPairsFor(record);

const clean = (text: string): string => sanitizeForCrawlers(text);

const headingId = (text: string): string =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const sectionIds = sections.map((s) => headingId(s.heading));
const pros = tradeoffs?.pros ?? [];
const cons = tradeoffs?.cons ?? [];
const hasTradeoffs = pros.length > 0 || cons.length > 0;

// Breadcrumb trail from the slug, matching the BreadcrumbList node.
const segments = record.slug.replace(/^\/+|\/+$/g, "").split("/").filter(Boolean);
const crumbs = segments.map((segment, i) => ({
  name: segment.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
  href: `/${segments.slice(0, i + 1).join("/")}/`,
}));
---

{/* Emitted here rather than passed up to the layout: a component that owns the
    markup also owns the schema, so the two cannot be deployed apart. */}
<script type="application/ld+json" set:html={jsonldString} />

{/*
  data-fixed-chrome publishes the list of selectors the similarity gate must
  strip before shingling. Reading it from the rendered HTML means the gate can
  never drift out of sync with the markup: add a fixed block here without
  declaring it in FIXED_CHROME_SELECTORS and the gate would score boilerplate
  as prose, making every page look like a duplicate of every other.
*/}
<article
  class="px-4 sm:px-6 lg:px-8 py-16 sm:py-24"
  data-fixed-chrome={FIXED_CHROME_SELECTORS.join(",")}
>
  <div class="max-w-3xl mx-auto">

    {/* FIXED: breadcrumb */}
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="aeo-breadcrumb text-xs text-white/40 mb-6">
        <a href="/" class="hover:text-white/70 transition-colors">Home</a>
        {crumbs.map((crumb, i) => (
          <>
            <span class="mx-2 text-white/20">/</span>
            {i === crumbs.length - 1 ? (
              <span class="text-white/60" aria-current="page">{crumb.name}</span>
            ) : (
              <a href={crumb.href} class="hover:text-white/70 transition-colors">{crumb.name}</a>
            )}
          </>
        ))}
      </nav>
    )}

    <header class="mb-10">
      <h1 class="text-4xl sm:text-5xl font-bold text-[#F8F8F8] leading-tight mb-6">
        {clean(title)}
      </h1>
    </header>

    {/*
      The answer box. First prose on the page, and the only block an answer
      engine needs to read to get the answer. Its text is the FAQPage
      acceptedAnswer for the canonical question, and .answer-box is the first
      speakable selector.
    */}
    <section class="answer-box mb-12 p-6 rounded-xl bg-purple-600/10 border border-purple-500/20">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-purple-300/80 mb-3">
        {clean(canonicalQuestion)}
      </h2>
      <p class="text-lg text-white/85 leading-relaxed">{clean(answer)}</p>
    </section>

    {/* FIXED: table of contents */}
    {sections.length >= 3 && (
      <nav class="aeo-toc card mb-12" aria-label="Table of contents">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-4">
          Contents
        </h2>
        <ol class="space-y-2 text-sm">
          {sections.map((section, i) => (
            <li>
              <a href={`#${sectionIds[i]}`} class="text-purple-400 hover:text-purple-300 transition-colors">
                {i + 1}. {clean(section.heading)}
              </a>
            </li>
          ))}
          {hasTradeoffs && (
            <li>
              <a href="#tradeoffs" class="text-purple-400 hover:text-purple-300 transition-colors">
                Pros and Cons
              </a>
            </li>
          )}
          {faqs.length > 0 && (
            <li>
              <a href="#faq" class="text-purple-400 hover:text-purple-300 transition-colors">
                Frequently Asked Questions
              </a>
            </li>
          )}
        </ol>
      </nav>
    )}

    {/* Per-page prose. This is what the similarity gate scores. */}
    {sections.map((section, i) => (
      <section id={sectionIds[i]} class="mb-14 prose-dark">
        {section.heading_level === 2 ? (
          <h2 class="text-2xl sm:text-3xl font-bold text-[#F8F8F8] mb-5">
            {i + 1}. {clean(section.heading)}
          </h2>
        ) : (
          <h3 class="text-xl font-bold text-[#F8F8F8] mb-4">{clean(section.heading)}</h3>
        )}

        <div
          set:html={injectInternalLinks(
            renderSectionContent(section.content, section.content_type),
            internal_links
          )}
        />

        {section.subsections && section.subsections.length > 0 && (
          <div class="subsections mt-8 space-y-8">
            {section.subsections.map((sub) => (
              <div id={headingId(sub.heading)} class="subsection">
                <h3 class="text-lg font-bold text-[#F8F8F8] mt-6 mb-3">{clean(sub.heading)}</h3>
                <div
                  set:html={injectInternalLinks(
                    renderSectionContent(sub.content, sub.content_type),
                    internal_links
                  )}
                />
              </div>
            ))}
          </div>
        )}
      </section>
    ))}

    {proof_points.length > 0 && (
      <section class="mb-14" aria-label="Key facts">
        <h2 class="text-2xl font-bold text-[#F8F8F8] mb-5">Key Facts</h2>
        <ul class="space-y-3" role="list">
          {proof_points.map((point) => (
            <li class="text-sm text-white/70 leading-relaxed pl-4 border-l-2 border-emerald-500/40">
              {clean(point)}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/*
      Pros and cons are independent lists. The previous shape paired them row by
      row, which forced the columns to the same length and implied a
      correspondence between a pro and a con that never existed.
    */}
    {hasTradeoffs && (
      <section id="tradeoffs" class="mb-14" aria-label="Pros and cons">
        <h2 class="text-2xl font-bold text-[#F8F8F8] mb-5">Pros and Cons</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="card">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-4">Pros</h3>
            <ul class="space-y-3" role="list">
              {pros.map((p) => <li class="text-sm text-white/70">{clean(p)}</li>)}
            </ul>
          </div>
          <div class="card">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-rose-400 mb-4">Cons</h3>
            <ul class="space-y-3" role="list">
              {cons.map((c) => <li class="text-sm text-white/70">{clean(c)}</li>)}
            </ul>
          </div>
        </div>
      </section>
    )}

    {/*
      FAQ. Renders the same pairs the FAQPage node carries, in the same order,
      from the same array. Open by default: content behind a closed <details>
      is present in the HTML, but an open block is unambiguous for extraction.
    */}
    {faqs.length > 0 && (
      <section id="faq" class="faq supporting-questions mb-14" aria-label="Frequently asked questions">
        <h2 class="text-2xl font-bold text-[#F8F8F8] mb-6">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <div class="faq-item card">
              <h3 class="text-sm font-semibold text-white/90 leading-snug mb-2">
                {clean(faq.question)}
              </h3>
              <p class="text-sm text-white/65 leading-relaxed">{clean(faq.answer)}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* FIXED: sources. Required upstream, so it needs somewhere to render. */}
    {sources.length > 0 && (
      <section class="aeo-sources mb-14 border-t border-white/5 pt-10" aria-label="Sources and references">
        <h2 class="text-lg font-bold text-[#F8F8F8] mb-5">Sources and References</h2>
        <ul class="space-y-2" role="list">
          {sources.map((source) => (
            <li class="text-sm text-white/60">
              {source.url ? (
                <a href={source.url} rel="nofollow noopener" class="text-purple-400 hover:text-purple-300 underline underline-offset-2">
                  {clean(source.label)}
                </a>
              ) : (
                <span>{clean(source.label)}</span>
              )}
              <span class="text-white/30 ml-2">{source.type}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* FIXED: entity references */}
    {entity_references.length > 0 && (
      <section class="aeo-entities mb-14 border-t border-white/5 pt-10" aria-label="Related entities">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-white/30 mb-4">
          Related Entities
        </h2>
        <ul class="flex flex-wrap gap-2" role="list">
          {entity_references.map((entity) => (
            <li>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-white/50" data-entity-type={entity.type}>
                <span class="text-white/30">{entity.type}</span>
                <span class="text-white/60">{clean(entity.name)}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* FIXED: related resources. Mirrors WebPage.mentions exactly. */}
    {internal_links.length > 0 && (
      <section class="aeo-related mb-14 border-t border-white/5 pt-10" aria-label="Related resources">
        <h2 class="text-lg font-bold text-[#F8F8F8] mb-5">Related Resources</h2>
        <nav aria-label="Internal resource links">
          <ul class="space-y-2" role="list">
            {internal_links.map((link) => (
              <li>
                <a href={link.target_url} class="text-sm text-purple-400 hover:text-purple-300 transition-colors underline underline-offset-2">
                  {clean(link.target_title || link.anchor_text)}
                </a>
                <span class="text-xs text-white/30 ml-2">{link.relationship}</span>
              </li>
            ))}
          </ul>
        </nav>
      </section>
    )}

    {/* FIXED: call to action */}
    {cta && (
      <section class="aeo-cta mt-10 p-8 rounded-xl bg-purple-600/10 border border-purple-500/20 text-center" aria-label="Call to action">
        <p class="text-xl font-bold text-white mb-2">{clean(cta.text)}</p>
        {cta.subtext && (
          <p class="text-sm text-white/60 mb-6 max-w-lg mx-auto">{clean(cta.subtext)}</p>
        )}
        <a href={cta.href} class="btn-primary">{clean(cta.label)}</a>
      </section>
    )}

  </div>
</article>
