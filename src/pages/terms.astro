---
import BaseLayout from '../layouts/BaseLayout.astro';

const termsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms of Service - Generative Engine Solutions",
  "url": "https://generativeenginesolutions.com/terms/",
  "description": "Terms of Service for Generative Engine Solutions (GES). Governs use of the GES platform for Answer Engine Optimization.",
  "dateModified": "2026-04-14"
};
---

<BaseLayout
  title="Terms of Service - Generative Engine Solutions"
  description="Terms of Service for GES (Generative Engine Solutions). Covers subscriptions, acceptable use, intellectual property, liability, and contact information."
  canonicalPath="/terms/"
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(termsSchema)} />
  </Fragment>

  <div class="px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="max-w-3xl mx-auto">

      <!-- Header -->
      <header class="mb-12">
        <span class="section-label">Legal</span>
        <h1 class="text-4xl font-bold text-[#F8F8F8] mb-3 mt-2">Terms of Service</h1>
        <p class="text-sm text-white/40">Last updated: April 14, 2026</p>
        <p class="mt-4 text-white/60 text-sm leading-relaxed">
          These Terms of Service ("Terms") govern your access to and use of the Generative Engine Solutions platform and related services ("GES," "we," "us," or "our"). By accessing or using GES, you agree to be bound by these Terms. If you do not agree, do not use the platform.
        </p>
      </header>

      <div class="space-y-10 prose-dark">

        <!-- Section 1 -->
        <section id="acceptance">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">1. Acceptance of Terms</h2>
          <p>
            By creating an account, accessing, or using any part of the GES platform, you confirm that you are at least 16 years of age, have the legal capacity to enter into a binding agreement, and agree to comply with and be bound by these Terms and our Privacy Policy. If you are using GES on behalf of an organization, you represent that you have authority to bind that organization to these Terms.
          </p>
          <p>
            These Terms constitute a legally binding agreement between you (or your organization) and Generative Engine Solutions. Use of the platform constitutes acceptance of these Terms in full.
          </p>
        </section>

        <!-- Section 2 -->
        <section id="description">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">2. Description of Service</h2>
          <p>
            GES provides a self-serve software platform for Answer Engine Optimization (AEO) and Generative Engine Optimization (GEO). The platform consists of five core modules:
          </p>
          <ul class="mt-3 space-y-2">
            <li><strong class="text-white/90">Module 1: AEO Intelligence Report.</strong> Scans your brand across six AI search engines and returns a scored citation rate report.</li>
            <li><strong class="text-white/90">Module 2: Org Schema Builder.</strong> Generates JSON-LD structured markup for your organization.</li>
            <li><strong class="text-white/90">Module 3: Company Intelligence Gatherer.</strong> Builds a citable proof-point library for your brand.</li>
            <li><strong class="text-white/90">Module 4: ICP Content Strategy.</strong> Maps content pages to buyer questions that AI engines answer.</li>
            <li><strong class="text-white/90">Module 5: Page Converter.</strong> Transforms existing pages into LLM-optimized content assets.</li>
          </ul>
          <p>
            Modules are accessed by spending credits. Credits are allocated according to your subscription plan. GES reserves the right to modify, suspend, or discontinue any module or feature with reasonable notice.
          </p>
        </section>

        <!-- Section 3 -->
        <section id="account">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">3. Account Registration and Security</h2>
          <p>
            You must register for an account to use most features of the GES platform. When registering, you agree to provide accurate, current, and complete information and to keep your account information updated. You are responsible for maintaining the confidentiality of your login credentials and for all activity that occurs under your account.
          </p>
          <p>
            You must notify us immediately at <a href="mailto:support@generativeenginesolutions.com" class="text-purple-400 hover:text-purple-300">support@generativeenginesolutions.com</a> if you suspect unauthorized access to your account. GES is not liable for any loss or damage arising from your failure to safeguard your credentials.
          </p>
          <p>
            You may not share your account with others, create accounts by automated means, or create accounts under false pretenses. GES may suspend or terminate accounts that violate these provisions.
          </p>
        </section>

        <!-- Section 4 -->
        <section id="billing">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">4. Subscription Plans and Billing</h2>
          <p>GES offers three subscription tiers:</p>
          <ul class="mt-3 space-y-2">
            <li><strong class="text-white/90">Free:</strong> $0. Includes 5 one-time credits. Access to Module 1 only.</li>
            <li><strong class="text-white/90">Growth:</strong> $299 per month. Includes 50 credits refreshed monthly. Access to all 5 modules.</li>
            <li><strong class="text-white/90">Scale:</strong> $799 per month. Includes 200 credits refreshed monthly. Access to all 5 modules with custom onboarding.</li>
          </ul>
          <p>
            Paid plans are billed monthly in advance via Stripe. You authorize GES to charge the payment method on file at the start of each billing cycle. All charges are non-refundable except where required by law.
          </p>
          <p>
            Monthly credits reset on your billing date. Unused credits do not roll over to subsequent billing periods. Free plan credits have no expiry.
          </p>
          <p>
            GES may change pricing with 30 days' notice communicated via email or in-app notification. Continued use of the platform after a price change constitutes acceptance of the new pricing.
          </p>
          <p>
            To cancel, navigate to Settings and select Cancel Plan. Cancellation takes effect at the end of the current billing period. You retain access to your plan features through the end of the paid period.
          </p>
        </section>

        <!-- Section 5 -->
        <section id="acceptable-use">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">5. Acceptable Use Policy</h2>
          <p>You agree not to use GES to:</p>
          <ul class="mt-3 space-y-1.5">
            <li>Violate any applicable law, regulation, or third-party right.</li>
            <li>Generate, distribute, or publish content that is defamatory, fraudulent, or deceptive.</li>
            <li>Reverse engineer, decompile, or attempt to extract the source code of the GES platform.</li>
            <li>Use the platform to build a competing product or service without express written consent.</li>
            <li>Circumvent access controls, rate limits, or credit accounting systems.</li>
            <li>Introduce malicious code, viruses, or any other harmful components.</li>
            <li>Use automated scripts or bots to interact with the platform except through documented APIs.</li>
            <li>Misrepresent your identity, affiliation, or the origin of content you submit.</li>
          </ul>
          <p>
            GES reserves the right to investigate and take appropriate action against violations of this policy, including suspension or termination of your account and referral to law enforcement where warranted.
          </p>
        </section>

        <!-- Section 6 -->
        <section id="ip">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">6. Intellectual Property</h2>
          <p>
            You retain ownership of all content you submit to GES, including domain names, brand materials, and any content you provide as inputs to the modules. You also own the output generated by GES modules when run against your inputs.
          </p>
          <p>
            GES and its licensors retain all rights to the GES platform, software, algorithms, user interface, documentation, and all other proprietary technology. These Terms do not grant you any ownership rights in the GES platform.
          </p>
          <p>
            By using GES, you grant GES a limited, non-exclusive, royalty-free license to process your inputs and generate outputs on your behalf as needed to provide the service. GES does not use your content to train its AI models or share your content with other customers.
          </p>
        </section>

        <!-- Section 7 -->
        <section id="ai-disclaimer">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">7. AI-Generated Content Disclaimer</h2>
          <p>
            GES modules produce AI-generated outputs including structured data markup, content strategies, and optimized page content. These outputs are provided for informational and strategic purposes. GES does not guarantee that AI-generated outputs are accurate, complete, error-free, or suitable for any specific purpose.
          </p>
          <p>
            You are solely responsible for reviewing, editing, and deploying any AI-generated outputs to your website or marketing materials. GES is not liable for outcomes resulting from the deployment of AI-generated content, including changes in search rankings, AI citation rates, or other marketing metrics.
          </p>
          <p>
            AEO citation rates depend on the behavior of third-party AI systems (including OpenAI, Anthropic, Google, and Microsoft) over which GES has no control. GES does not guarantee specific citation rate outcomes.
          </p>
        </section>

        <!-- Section 8 -->
        <section id="data">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">8. Data Handling</h2>
          <p>
            Our collection, use, and protection of your personal data is governed by our <a href="/privacy" class="text-purple-400 hover:text-purple-300">Privacy Policy</a>, which is incorporated by reference into these Terms. By using GES, you consent to the data practices described in the Privacy Policy.
          </p>
        </section>

        <!-- Section 9 -->
        <section id="third-party">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">9. Third-Party Services</h2>
          <p>GES integrates with the following third-party services to deliver its platform:</p>
          <ul class="mt-3 space-y-1.5">
            <li><strong class="text-white/90">Stripe:</strong> Payment processing.</li>
            <li><strong class="text-white/90">Supabase:</strong> Database and authentication infrastructure.</li>
            <li><strong class="text-white/90">PostHog:</strong> Product analytics and event tracking.</li>
            <li><strong class="text-white/90">n8n:</strong> Workflow automation and module orchestration.</li>
            <li><strong class="text-white/90">Anthropic (Claude):</strong> AI content generation for certain modules.</li>
            <li><strong class="text-white/90">Google (Gemini):</strong> AI content generation for certain modules.</li>
            <li><strong class="text-white/90">DataforSEO:</strong> Search and AI engine data retrieval.</li>
          </ul>
          <p>
            Your use of GES is subject to the terms and privacy policies of these third-party providers. GES is not responsible for the practices or policies of third-party services.
          </p>
        </section>

        <!-- Section 10 -->
        <section id="liability">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">10. Limitation of Liability</h2>
          <p>
            To the fullest extent permitted by applicable law, GES and its officers, directors, employees, agents, and licensors shall not be liable for any indirect, incidental, special, consequential, punitive, or exemplary damages, including but not limited to loss of profits, revenue, data, goodwill, or business opportunities, arising from your use of or inability to use the GES platform.
          </p>
          <p>
            GES's total aggregate liability to you for all claims arising from or related to these Terms or the platform shall not exceed the total amounts paid by you to GES in the three months immediately preceding the event giving rise to the claim, or $100, whichever is greater.
          </p>
          <p>
            The GES platform is provided "as is" and "as available" without warranties of any kind, express or implied, including but not limited to warranties of merchantability, fitness for a particular purpose, and non-infringement.
          </p>
        </section>

        <!-- Section 11 -->
        <section id="termination">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">11. Termination</h2>
          <p>
            You may terminate your account at any time by canceling your subscription through the Settings page and ceasing use of the platform. GES may suspend or terminate your account at any time, with or without notice, for violation of these Terms or for any other reason GES deems appropriate.
          </p>
          <p>
            Upon termination, your right to access the GES platform ceases immediately. Any provisions of these Terms that by their nature should survive termination shall remain in force, including intellectual property, limitation of liability, and governing law provisions.
          </p>
        </section>

        <!-- Section 12 -->
        <section id="changes">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">12. Changes to Terms</h2>
          <p>
            GES may update these Terms from time to time. When we make material changes, we will notify you via email and/or a prominent notice on the platform at least 14 days before the changes take effect. Your continued use of the platform after the effective date constitutes acceptance of the updated Terms.
          </p>
          <p>
            The most current version of these Terms is always available at <a href="/terms" class="text-purple-400 hover:text-purple-300">app.generativeenginesolutions.com/terms</a>.
          </p>
        </section>

        <!-- Section 13 -->
        <section id="governing-law">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">13. Governing Law</h2>
          <p>
            These Terms are governed by the laws of the State of Texas, United States, without regard to conflict of law principles. Any disputes arising from these Terms or your use of GES shall be resolved exclusively in the state or federal courts located in Texas, and you consent to the personal jurisdiction of such courts.
          </p>
        </section>

        <!-- Section 14 -->
        <section id="contact">
          <h2 class="text-xl font-bold text-[#F8F8F8] mb-3">14. Contact</h2>
          <p>
            If you have questions about these Terms, please contact us at:
          </p>
          <div class="mt-3 card text-sm">
            <p class="text-white/80">Generative Engine Solutions</p>
            <p class="text-white/60 mt-1">Email: <a href="mailto:legal@generativeenginesolutions.com" class="text-purple-400 hover:text-purple-300">legal@generativeenginesolutions.com</a></p>
            <p class="text-white/60 mt-0.5">Website: <a href="https://app.generativeenginesolutions.com" class="text-purple-400 hover:text-purple-300">app.generativeenginesolutions.com</a></p>
          </div>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>
