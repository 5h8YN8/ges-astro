---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingTable from '../components/PricingTable.astro';
import ModuleCard from '../components/ModuleCard.astro';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Generative Engine Solutions",
  "alternateName": "GES",
  "url": "https://app.generativeenginesolutions.com",
  "logo": "https://app.generativeenginesolutions.com/images/logo-dark.png",
  "description": "Self-serve platform for Answer Engine Optimization (AEO) and Generative Engine Optimization (GEO). Helps businesses get cited by AI search engines.",
  "sameAs": ["https://x.com/generativeengin"]
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "GES - Generative Engine Solutions",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": [
    {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
      "name": "Free",
      "description": "5 credits, Module 1 AEO Report"
    },
    {
      "@type": "Offer",
      "price": "299",
      "priceCurrency": "USD",
      "name": "Growth",
      "description": "50 credits/mo, All 5 modules"
    },
    {
      "@type": "Offer",
      "price": "799",
      "priceCurrency": "USD",
      "name": "Scale",
      "description": "200 credits/mo, All 5 modules, Custom onboarding"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is AEO and why does it matter?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Answer Engine Optimization (AEO) is the practice of optimizing your brand's content so AI systems like ChatGPT, Perplexity, and Google's AI Overview cite you in their answers. As more users skip traditional search results in favor of AI-generated answers, brands invisible to these engines lose traffic and revenue."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between AEO and GEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Answer Engine Optimization (AEO) focuses on making your content citable by AI search engines like ChatGPT and Perplexity. Generative Engine Optimization (GEO) is broader, covering reputation management, agent-to-agent protocols, API discovery, and commerce readiness. GES launches with AEO and will expand to full GEO capabilities."
      }
    },
    {
      "@type": "Question",
      "name": "How does GES differ from traditional SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Traditional SEO optimizes for keyword rankings. Generative Engine Solutions (GES) optimizes for AI citation, structured data, proof points, and content formats that LLMs are trained to reference and quote."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to see results?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most clients see measurable citation improvements within 4 to 8 weeks of deploying GES-optimized pages."
      }
    },
    {
      "@type": "Question",
      "name": "What are credits?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Credits are consumed each time you run a module. Module 2 (Schema) costs 1 credit, Module 3 (Intelligence) costs 2 credits per scan, Module 4 (Strategy) costs 8 to 20 credits depending on volume, and Module 5 (Page generation) costs 1 credit per page."
      }
    },
    {
      "@type": "Question",
      "name": "Can I cancel anytime?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. All paid plans are month-to-month with no long-term contracts. You can cancel or downgrade from the Settings page at any time."
      }
    }
  ]
};

const modules = [
  {
    number: 1,
    name: "AEO Intelligence Report",
    description: "Free AEO Intelligence Report: See how visible your brand is across 6 AI search engines.",
    detail: "Scans ChatGPT, Perplexity, Claude, Google AI Overview, Gemini, and Copilot to measure your citation rate and surface specific gaps.",
    free: true,
    icon: "📊",
  },
  {
    number: 2,
    name: "Org Schema Builder",
    description: "Generate JSON-LD @graph markup that LLMs can parse.",
    detail: "Produces standards-compliant Organization, Product, and FAQ schema that structured-data crawlers and language models use to understand your brand.",
    free: false,
    icon: "🔧",
  },
  {
    number: 3,
    name: "Company Intelligence",
    description: "Build the proof-point library AI engines cite.",
    detail: "Collects and organizes factual claims, statistics, and brand differentiators into a citable knowledge base that LLMs surface in brand-related queries.",
    free: false,
    icon: "🔍",
  },
  {
    number: 4,
    name: "ICP Content Strategy",
    description: "Map 30 to 100 pages to buyer questions AI answers.",
    detail: "Identifies the exact questions your ideal customers ask AI engines and maps a content plan that positions your brand as the authoritative answer.",
    free: false,
    icon: "🗺️",
  },
  {
    number: 5,
    name: "Page Converter",
    description: "Transform existing pages into LLM-optimized assets.",
    detail: "Rewrites or restructures your existing content to use the heading hierarchy, semantic structure, and factual density that language models prefer to quote.",
    free: false,
    icon: "✨",
  },
];
---

<BaseLayout
  title="GES - Get Your Brand Cited by AI Search Engines"
  description="Generative Engine Solutions is the self-serve platform for Answer Engine Optimization (AEO) and Generative Engine Optimization (GEO). Start with a free AEO score across 6 AI engines."
  canonicalPath="/"
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Hero Section -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 pt-20 pb-24 sm:pt-28 sm:pb-32">
    <!-- Background glow -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-purple-600/10 rounded-full blur-3xl"></div>
      <div class="absolute top-20 left-1/4 w-[300px] h-[300px] bg-purple-800/5 rounded-full blur-2xl"></div>
    </div>

    <div class="relative max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 bg-purple-600/10 border border-purple-500/20 rounded-full px-4 py-1.5 mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
        <span class="text-xs font-medium text-purple-300">Answer Engine Optimization Platform</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-[#F8F8F8] leading-tight mb-6">
        Get your brand cited by<br class="hidden sm:block" />
        <span class="text-purple-400">AI search engines</span>
      </h1>

      <p class="text-lg sm:text-xl text-white/60 max-w-2xl mx-auto mb-10 leading-relaxed">
        GES is the self-serve platform that starts with AEO (Answer Engine Optimization) and expands to full GEO (Generative Engine Optimization). Five modules. One workflow. Measurable AI visibility.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/report/new" class="btn-primary text-base px-8 py-3.5">
          Get your free AEO score
        </a>
        <a href="#funnel" class="btn-secondary text-base px-8 py-3.5">
          See how it works
        </a>
      </div>

      <!-- Engine logos row -->
      <div class="mt-14 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        <p class="text-xs text-white/30 w-full text-center mb-1">Analyzes your visibility across</p>
        {['ChatGPT', 'Perplexity', 'Claude', 'Google AI', 'Gemini', 'Copilot'].map((engine) => (
          <span class="text-xs font-medium text-white/40 border border-white/10 px-3 py-1 rounded-full">{engine}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- 5-Module Funnel Section -->
  <section id="funnel" class="px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <span class="section-label">Platform</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-[#F8F8F8] mb-4">
          Start with AEO. Scale to full GEO.
        </h2>
        <p class="text-lg text-white/50 max-w-2xl mx-auto">
          Five modules designed to work together. Start free with Module 1 and unlock the full optimization workflow.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {modules.map((mod) => (
          <ModuleCard
            number={mod.number}
            name={mod.name}
            description={mod.description}
            detail={mod.detail}
            free={mod.free}
            icon={mod.icon}
          />
        ))}
        <!-- CTA card in last slot -->
        <div class="card flex flex-col items-center justify-center text-center p-8 border-dashed">
          <p class="text-sm text-white/40 mb-4">Ready to start?</p>
          <a href="/report/new" class="btn-primary text-sm">
            Run your free AEO report
          </a>
          <p class="text-xs text-white/30 mt-3">No credit card required</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="px-4 sm:px-6 lg:px-8 py-20 sm:py-28 border-t border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <span class="section-label">Pricing</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-[#F8F8F8] mb-4">
          Simple, transparent pricing
        </h2>
        <p class="text-lg text-white/50 max-w-xl mx-auto">
          Start free with Module 1. Upgrade when you're ready to run the full optimization workflow.
        </p>
      </div>
      <PricingTable />
      <p class="text-center text-xs text-white/30 mt-8">
        All plans are month-to-month. Cancel anytime. Prices in USD.
      </p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="px-4 sm:px-6 lg:px-8 py-20 sm:py-28 border-t border-white/5">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <span class="section-label">FAQ</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-[#F8F8F8] mb-4">
          Frequently asked questions
        </h2>
      </div>

      <div class="space-y-3">
        <!-- FAQ 1 -->
        <details class="card group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer py-1">
            <span class="text-sm font-semibold text-[#F8F8F8] group-open:text-purple-300 transition-colors">
              What is AEO and why does it matter?
            </span>
            <svg class="summary-chevron shrink-0 transition-transform duration-200 text-white/30" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-white/60 leading-relaxed">
            Answer Engine Optimization (AEO) is the practice of optimizing your brand's content so AI systems like ChatGPT, Perplexity, and Google's AI Overview cite you in their answers. As more users skip traditional search results in favor of AI-generated answers, brands invisible to these engines lose traffic and revenue.
          </p>
        </details>

        <!-- FAQ 2 -->
        <details class="card group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer py-1">
            <span class="text-sm font-semibold text-[#F8F8F8] group-open:text-purple-300 transition-colors">
              What is the difference between AEO and GEO?
            </span>
            <svg class="summary-chevron shrink-0 transition-transform duration-200 text-white/30" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-white/60 leading-relaxed">
            Answer Engine Optimization (AEO) focuses on making your content citable by AI search engines like ChatGPT and Perplexity. Generative Engine Optimization (GEO) is broader, covering reputation management, agent-to-agent protocols, API discovery, and commerce readiness. GES launches with AEO and will expand to full GEO capabilities.
          </p>
        </details>

        <!-- FAQ 3 -->
        <details class="card group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer py-1">
            <span class="text-sm font-semibold text-[#F8F8F8] group-open:text-purple-300 transition-colors">
              How does GES differ from traditional SEO?
            </span>
            <svg class="summary-chevron shrink-0 transition-transform duration-200 text-white/30" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-white/60 leading-relaxed">
            Traditional SEO optimizes for keyword rankings. Generative Engine Solutions (GES) optimizes for AI citation, structured data, proof points, and content formats that LLMs are trained to reference and quote.
          </p>
        </details>

        <!-- FAQ 4 -->
        <details class="card group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer py-1">
            <span class="text-sm font-semibold text-[#F8F8F8] group-open:text-purple-300 transition-colors">
              How long does it take to see results?
            </span>
            <svg class="summary-chevron shrink-0 transition-transform duration-200 text-white/30" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-white/60 leading-relaxed">
            Most clients see measurable citation improvements within 4 to 8 weeks of deploying GES-optimized pages.
          </p>
        </details>

        <!-- FAQ 5 -->
        <details class="card group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer py-1">
            <span class="text-sm font-semibold text-[#F8F8F8] group-open:text-purple-300 transition-colors">
              What are credits?
            </span>
            <svg class="summary-chevron shrink-0 transition-transform duration-200 text-white/30" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-white/60 leading-relaxed">
            Credits are consumed each time you run a module. Module 2 (Schema) costs 1 credit, Module 3 (Intelligence) costs 2 credits per scan, Module 4 (Strategy) costs 8 to 20 credits depending on volume, and Module 5 (Page generation) costs 1 credit per page.
          </p>
        </details>

        <!-- FAQ 6 -->
        <details class="card group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer py-1">
            <span class="text-sm font-semibold text-[#F8F8F8] group-open:text-purple-300 transition-colors">
              Can I cancel anytime?
            </span>
            <svg class="summary-chevron shrink-0 transition-transform duration-200 text-white/30" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm text-white/60 leading-relaxed">
            Yes. All paid plans are month-to-month with no long-term contracts. You can cancel or downgrade from the Settings page at any time.
          </p>
        </details>
      </div>

      <div class="mt-10 text-center">
        <p class="text-sm text-white/40 mb-4">Still have questions?</p>
        <a href="mailto:hello@generativeenginesolutions.com" class="text-sm text-purple-400 hover:text-purple-300 transition-colors underline">
          Contact us
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="px-4 sm:px-6 lg:px-8 py-20 sm:py-28 border-t border-white/5">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-[#F8F8F8] mb-4">
        Find out where your brand stands today
      </h2>
      <p class="text-lg text-white/50 mb-8">
        Run your free AEO Intelligence Report in minutes. No credit card required. See exactly how AI engines see your brand.
      </p>
      <a href="/report/new" class="btn-primary text-base px-10 py-4">
        Get your free AEO score
      </a>
    </div>
  </section>
</BaseLayout>
